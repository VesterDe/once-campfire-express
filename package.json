    "express": "5.2.1",
    "multer": "2.4.0",
    "nunjucks": "3.2.4",
    "parse5": "8.0.1",
    "qrcode": "1.5.4",
    "sanitize-html": "2.18.0",
    "sharp": "0.35.5",
    "web-push": "3.6.7",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "prettier": "3.9.9"
  }
}
