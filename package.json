{
  "name": "once-campfire-express",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "node bin/test.js",
    "build:assets": "node bin/build-assets.js",
